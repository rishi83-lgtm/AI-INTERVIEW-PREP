# Required for account persistence
MONGO_URI=mongodb://127.0.0.1:27017/interviewiq
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
PORT=5000
ALLOW_LOCAL_FALLBACK=false

# Required for live answers in the Ask InterviewIQ chat.
# Create this key in the OpenAI dashboard; never put it in frontend variables.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
