# Required for account persistence
MONGO_URI=mongodb://127.0.0.1:27017/interviewiq
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
PORT=5000

# Optional: enables live answers in the Ask InterviewIQ page.
# Create this key in the OpenAI dashboard; never put it in frontend variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
